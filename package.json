{
  "name": "fit-five",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.1",
  "scripts": {
    "dev": "turbo dev",
    "dev:mobile": "pnpm --filter @fit-five/mobile dev",
    "dev:api": "pnpm --filter @fit-five/api start:dev",
    "dev:worker": "pnpm --filter @fit-five/api start:worker",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "eslint": "^9.28.0",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0"
  }
}

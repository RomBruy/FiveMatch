{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@fivematch/types": [
        "../../packages/types/src/index.ts"
      ],
      "@fivematch/types/*": [
        "../../packages/types/src/*"
      ],
      "@fivematch/api-client": [
        "../../packages/api-client/src/index.ts"
      ],
      "~/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.d.ts",
    "expo-env.d.ts",
    ".expo/types/**/*.ts",
    "nativewind-env.d.ts"
  ]
}
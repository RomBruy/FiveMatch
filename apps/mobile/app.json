{
  "expo": {
    "name": "FiveMatch",
    "slug": "fivematch",
    "version": "1.0.0",
    "scheme": "fivematch",
    "orientation": "portrait",
    "icon": "./assets/brand/icon-v2.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/brand/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#101013"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fivematch.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "backgroundColor": "#101013"
      },
      "package": "com.fivematch.app"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101013",
          "image": "./assets/brand/splash-logo.png",
          "imageWidth": 320,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/notification-icon.png",
          "color": "#FF4438"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "apple-ios",
          "organization": "fivematch"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "newArchEnabled": true
          },
          "android": {
            "newArchEnabled": true
          }
        }
      ],
      "@sentry/react-native",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String                  @id @default(cuid())
  clerkUserId        String                  @unique @map("clerk_user_id")
  emailAddress       String?                 @map("email_address")
  firstName          String?                 @map("first_name")
  lastName           String?                 @map("last_name")
  imageUrl           String?                 @map("image_url")
  preferredLocale    String                  @default("fr") @map("preferred_locale")
  ownedGroups        Group[]                 @relation("GroupOwner")
  groupMemberships   GroupMember[]
  playerProfiles     Player[]
  createdInvitations Invitation[]            @relation("InvitationCreator")
  organizedMatches   Match[]                 @relation("MatchOrganizer")
  submittedScores    Match[]                 @relation("MatchScoreSubmitter")
  recordedMatchEvents MatchEvent[]           @relation("MatchEventRecorder")
  teamGenerations    TeamGenerationVersion[] @relation("TeamGenerationCreator")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")

  @@map("users")
}

model Group {
  id                 String              @id @default(cuid())
  name               String
  ownerUserId        String              @map("owner_user_id")
  owner              User                @relation("GroupOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  settings           GroupSettings?
  members            GroupMember[]
  invitations        Invitation[]
  players            Player[]
  initialPeerRatings InitialPeerRating[]
  matches            Match[]
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@index([ownerUserId], map: "idx_groups_owner_user_id")
  @@map("groups")
}

model GroupSettings {
  id              String   @id @default(cuid())
  groupId         String   @unique @map("group_id")
  group           Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  defaultLanguage String   @map("default_language")
  playStyle       String   @map("play_style")
  intensity       String
  goalkeeperMode  String   @map("goalkeeper_mode")
  generatorStyle  String   @map("generator_style")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("group_settings")
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String   @map("group_id")
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  joinedAt  DateTime @default(now()) @map("joined_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([groupId, userId], map: "uq_group_members_group_id_user_id")
  @@index([userId], map: "idx_group_members_user_id")
  @@map("group_members")
}

model Invitation {
  id              String    @id @default(cuid())
  groupId         String    @map("group_id")
  group           Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdByUserId String    @map("created_by_user_id")
  createdBy       User      @relation("InvitationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  token           String    @unique
  status          String    @default("active")
  usageCount      Int       @default(0) @map("usage_count")
  expiresAt       DateTime? @map("expires_at")
  lastAcceptedAt  DateTime? @map("last_accepted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([groupId], map: "idx_invitations_group_id")
  @@index([createdByUserId], map: "idx_invitations_created_by_user_id")
  @@map("invitations")
}

model Player {
  id                     String              @id @default(cuid())
  groupId                String              @map("group_id")
  group                  Group               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId                 String              @map("user_id")
  user                   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  initialRatingsGiven    InitialPeerRating[] @relation("InitialPeerRatingsGiven")
  initialRatingsReceived InitialPeerRating[] @relation("InitialPeerRatingsReceived")
  matchAttendances       MatchAttendance[]
  matchEvents            MatchEvent[]
  firstName              String?             @map("first_name")
  lastName               String?             @map("last_name")
  nickname               String?
  photoUrl               String?             @map("photo_url")
  bio                    String?
  dominantFoot           String?             @map("dominant_foot")
  jerseyNumber           Int?                @map("jersey_number")
  preferredStyle         String?             @map("preferred_style")
  clubDeFormation        String?             @map("club_de_formation")
  specialty              String?
  favoriteExcuse         String?             @map("favorite_excuse")
  badFaithLevel          Int?                @map("bad_faith_level")
  lockerRoomStyle        String?             @map("locker_room_style")
  thirdHalfProfile       String?             @map("third_half_profile")
  warCry                 String?             @map("war_cry")
  signatureCelebration   String?             @map("signature_celebration")
  worstOnPitchHabit      String?             @map("worst_on_pitch_habit")
  legendaryPhrase        String?             @map("legendary_phrase")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")

  @@unique([groupId, userId], map: "uq_players_group_id_user_id")
  @@index([userId], map: "idx_players_user_id")
  @@map("players")
}

model InitialPeerRating {
  id            String    @id @default(cuid())
  groupId       String    @map("group_id")
  group         Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  raterPlayerId String    @map("rater_player_id")
  raterPlayer   Player    @relation("InitialPeerRatingsGiven", fields: [raterPlayerId], references: [id], onDelete: Cascade)
  ratedPlayerId String    @map("rated_player_id")
  ratedPlayer   Player    @relation("InitialPeerRatingsReceived", fields: [ratedPlayerId], references: [id], onDelete: Cascade)
  attributeSet  String    @map("attribute_set")
  overall       Int
  speed         Int?
  attack        Int?
  technique     Int?
  defense       Int?
  reflexes      Int?
  positioning   Int?
  handling      Int?
  distribution  Int?
  communication Int?
  physical      Int
  stamina       Int?
  fun           Int
  lockedAt      DateTime? @map("locked_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([groupId, raterPlayerId, ratedPlayerId], map: "uq_initial_peer_ratings_group_rater_rated")
  @@index([ratedPlayerId], map: "idx_initial_peer_ratings_rated_player_id")
  @@index([raterPlayerId], map: "idx_initial_peer_ratings_rater_player_id")
  @@map("initial_peer_ratings")
}

model Match {
  id                     String                  @id @default(cuid())
  groupId                String                  @map("group_id")
  group                  Group                   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  organizerUserId        String                  @map("organizer_user_id")
  organizer              User                    @relation("MatchOrganizer", fields: [organizerUserId], references: [id], onDelete: Restrict)
  title                  String
  startsAt               DateTime                @map("starts_at")
  location               String
  playersPerTeam         Int                     @map("players_per_team")
  maxPlayers             Int                     @map("max_players")
  attendanceDeadlineAt   DateTime                @map("attendance_deadline_at")
  generatorStyleOverride String?                 @map("generator_style_override")
  goalkeeperModeOverride String?                 @map("goalkeeper_mode_override")
  status                 String                  @default("open")
  teamAScore             Int?                    @map("team_a_score")
  teamBScore             Int?                    @map("team_b_score")
  scoreSubmittedByUserId String?                 @map("score_submitted_by_user_id")
  scoreSubmittedBy       User?                   @relation("MatchScoreSubmitter", fields: [scoreSubmittedByUserId], references: [id], onDelete: SetNull)
  scoreSubmittedAt       DateTime?               @map("score_submitted_at")
  attendances            MatchAttendance[]
  events                 MatchEvent[]
  teamGenerations        TeamGenerationVersion[]
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  @@index([groupId, startsAt], map: "idx_matches_group_id_starts_at")
  @@index([organizerUserId], map: "idx_matches_organizer_user_id")
  @@index([scoreSubmittedByUserId], map: "idx_matches_score_submitted_by_user_id")
  @@map("matches")
}

model MatchEvent {
  id               String   @id @default(cuid())
  matchId          String   @map("match_id")
  match            Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId         String   @map("player_id")
  player           Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  kind             String
  count            Int
  recordedByUserId String   @map("recorded_by_user_id")
  recordedBy       User     @relation("MatchEventRecorder", fields: [recordedByUserId], references: [id], onDelete: Restrict)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([matchId, playerId, kind], map: "uq_match_events_match_player_kind")
  @@index([matchId, kind], map: "idx_match_events_match_id_kind")
  @@index([playerId], map: "idx_match_events_player_id")
  @@index([recordedByUserId], map: "idx_match_events_recorded_by_user_id")
  @@map("match_events")
}

model MatchAttendance {
  id               String   @id @default(cuid())
  matchId          String   @map("match_id")
  match            Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId         String   @map("player_id")
  player           Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  response         String
  status           String
  waitlistPosition Int?     @map("waitlist_position")
  respondedAt      DateTime @default(now()) @map("responded_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([matchId, playerId], map: "uq_match_attendances_match_id_player_id")
  @@index([matchId, status], map: "idx_match_attendances_match_id_status")
  @@index([playerId], map: "idx_match_attendances_player_id")
  @@map("match_attendances")
}

model TeamGenerationVersion {
  id                 String   @id @default(cuid())
  matchId            String   @map("match_id")
  match              Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  generatedByUserId  String   @map("generated_by_user_id")
  generatedBy        User     @relation("TeamGenerationCreator", fields: [generatedByUserId], references: [id], onDelete: Restrict)
  versionNumber      Int      @map("version_number")
  seed               String
  algorithmVersion   String   @map("algorithm_version")
  status             String   @default("draft")
  teamA              Json     @map("team_a")
  teamB              Json     @map("team_b")
  teamATotal         Float    @map("team_a_total")
  teamBTotal         Float    @map("team_b_total")
  fairnessPercentage Int      @map("fairness_percentage")
  inputSnapshot      Json     @map("input_snapshot")
  scoreComponents    Json     @map("score_components")
  explanation        Json
  manualAdjustment   Json?    @map("manual_adjustment")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([matchId, versionNumber], map: "uq_team_generation_versions_match_version")
  @@index([matchId], map: "idx_team_generation_versions_match_id")
  @@index([generatedByUserId], map: "idx_team_generation_versions_generated_by_user_id")
  @@map("team_generation_versions")
}

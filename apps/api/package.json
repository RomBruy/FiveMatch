{
  "name": "@fivematch/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate:test": "tsx scripts/migrate-test-database.ts",
    "audit:phase0": "tsx scripts/phase0-audit-report.ts"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.0.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@clerk/express": "^1.3.0",
    "@fivematch/types": "workspace:*",
    "@google/generative-ai": "^0.21.0",
    "@sentry/node": "^8.45.0",
    "drizzle-orm": "^0.38.3",
    "expo-server-sdk": "^6.1.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "svix": "^1.95.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@fivematch/test-utils": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.0",
    "drizzle-kit": "^0.30.1",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
